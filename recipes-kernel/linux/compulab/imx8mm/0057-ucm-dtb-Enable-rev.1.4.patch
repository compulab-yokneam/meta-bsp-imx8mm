 create mode 100644 arch/arm64/boot/dts/compulab/wifi-lwb5.dtsi

diff --git a/arch/arm64/boot/dts/compulab/ucm-imx8m-mini-rev1.4.dts b/arch/arm64/boot/dts/compulab/ucm-imx8m-mini-rev1.4.dts
